# Copy to .env; change secrets before starting. Do not commit .env.
# Atlas hackathon sandbox connection string:
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=market_council_audit
# Generate with: openssl rand -hex 24
ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET_MIN_16_CHARACTERS
BROKER_SHARED_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
WEB_PORT=3187
# Optional LLM-generated narratives. Disabled by default; core controls do not use LLM output.
ENABLE_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Demo execution gap in milliseconds to give time to press the kill switch
EXECUTION_DELAY_MS=4500
# sample = labelled illustrative snapshots; finnhub = provider quotes/news (free tier may limit exchange coverage)
DATA_MODE=sample
FINNHUB_API_KEY=
# v0.5: Watchlist scans are started by the operator (2 to 10 symbols).
# No background scanning or automatic trading is enabled.
